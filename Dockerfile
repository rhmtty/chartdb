FROM node:24-alpine AS builder

ARG VITE_OPENAI_API_KEY
ARG VITE_OPENAI_API_ENDPOINT
ARG VITE_LLM_MODEL_NAME
ARG VITE_HIDE_CHARTDB_CLOUD
ARG VITE_DISABLE_ANALYTICS
ARG VITE_SYNC_ENABLED
ARG VITE_SYNC_AUTO_SAVE
ARG VITE_BITBUCKET_API_BASE
ARG VITE_BITBUCKET_WORKSPACE
ARG VITE_BITBUCKET_REPO
ARG VITE_BITBUCKET_GIT_URL
ARG VITE_BITBUCKET_BRANCH
ARG VITE_BITBUCKET_FILE_PATH
ARG VITE_BITBUCKET_USERNAME
ARG VITE_BITBUCKET_APP_PASSWORD
ARG VITE_BITBUCKET_API_TOKEN
ARG VITE_SYNC_POLL_INTERVAL_MS
ARG VITE_SYNC_GIT_CORS_PROXY

WORKDIR /usr/src/app

COPY package.json package-lock.json ./

RUN npm ci

COPY . .

RUN echo "VITE_OPENAI_API_KEY=${VITE_OPENAI_API_KEY}" > .env && \
    echo "VITE_OPENAI_API_ENDPOINT=${VITE_OPENAI_API_ENDPOINT}" >> .env && \
    echo "VITE_LLM_MODEL_NAME=${VITE_LLM_MODEL_NAME}" >> .env && \
    echo "VITE_HIDE_CHARTDB_CLOUD=${VITE_HIDE_CHARTDB_CLOUD}" >> .env && \
    echo "VITE_DISABLE_ANALYTICS=${VITE_DISABLE_ANALYTICS}" >> .env && \
    echo "VITE_SYNC_ENABLED=${VITE_SYNC_ENABLED}" >> .env && \
    echo "VITE_SYNC_AUTO_SAVE=${VITE_SYNC_AUTO_SAVE}" >> .env && \
    echo "VITE_BITBUCKET_API_BASE=${VITE_BITBUCKET_API_BASE}" >> .env && \
    echo "VITE_BITBUCKET_WORKSPACE=${VITE_BITBUCKET_WORKSPACE}" >> .env && \
    echo "VITE_BITBUCKET_REPO=${VITE_BITBUCKET_REPO}" >> .env && \
    echo "VITE_BITBUCKET_GIT_URL=${VITE_BITBUCKET_GIT_URL}" >> .env && \
    echo "VITE_BITBUCKET_BRANCH=${VITE_BITBUCKET_BRANCH}" >> .env && \
    echo "VITE_BITBUCKET_FILE_PATH=${VITE_BITBUCKET_FILE_PATH}" >> .env && \
    echo "VITE_BITBUCKET_USERNAME=${VITE_BITBUCKET_USERNAME}" >> .env && \
    echo "VITE_BITBUCKET_APP_PASSWORD=${VITE_BITBUCKET_APP_PASSWORD}" >> .env && \
    echo "VITE_BITBUCKET_API_TOKEN=${VITE_BITBUCKET_API_TOKEN}" >> .env && \
    echo "VITE_SYNC_POLL_INTERVAL_MS=${VITE_SYNC_POLL_INTERVAL_MS}" >> .env && \
    echo "VITE_SYNC_GIT_CORS_PROXY=${VITE_SYNC_GIT_CORS_PROXY}" >> .env

RUN npm run build

FROM nginx:stable-alpine AS production

COPY --from=builder /usr/src/app/dist /usr/share/nginx/html
COPY ./default.conf.template /etc/nginx/conf.d/default.conf.template
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]