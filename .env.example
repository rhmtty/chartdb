# Copy to .env and adjust. ChartDB reads VITE_* at build time; when running the
# Docker image these same values are injected at runtime via window.env.

# --- Optional: OpenAI-powered smart query ---
# VITE_OPENAI_API_KEY=
# VITE_OPENAI_API_ENDPOINT=
# VITE_LLM_MODEL_NAME=

# --- Optional: hide the "Star us" / ChartDB cloud prompts ---
# VITE_HIDE_CHARTDB_CLOUD=true
# VITE_DISABLE_ANALYTICS=true

# --- Cross-team collaboration via a shared Bitbucket Cloud repo ---
# Set VITE_SYNC_ENABLED=true and point the editor at a Bitbucket Cloud repo that
# holds the shared ERD JSON file(s). Every analyst's edits are pushed to the file
# and pulled back automatically (polling), so the whole team stays in sync.
#
# VITE_BITBUCKET_WORKSPACE: Bitbucket workspace slug (the team/account).
# VITE_BITBUCKET_REPO:       repository slug holding the ERD JSON file.
# VITE_BITBUCKET_GIT_URL:    HTTPS clone URL of the repo used for writes, e.g.
#                            https://<username>@bitbucket.org/<workspace>/<repo>.git
#                            (default: https://bitbucket.org/<workspace>/<repo>.git).
# VITE_BITBUCKET_BRANCH:     branch to read/write (default: main).
# VITE_BITBUCKET_FILE_PATH:  path in the repo; {diagramId} is replaced per diagram
#                            (default: erd.json).
# VITE_BITBUCKET_USERNAME:   Atlassian account email of the shared sync account.
# VITE_BITBUCKET_APP_PASSWORD: repo-scoped app password (keep it read/write on
#                            this repo only; anyone with the app can read it).
# VITE_BITBUCKET_API_TOKEN:  Bitbucket API token (replaces app passwords for git).
#                            Create one at bitbucket.org > Personal settings > API
#                            tokens with read:repository:bitbucket and
#                            write:repository:bitbucket. When set, git pushes use
#                            it with the static username x-token-auth. Preferred
#                            over the app password on Atlassian accounts, where
#                            app passwords are rejected for git smart-HTTP.
# VITE_SYNC_GIT_CORS_PROXY: same-origin path that proxies git smart-HTTP to the
#                            remote (Bitbucket sends no CORS headers). The nginx
#                            container and the vite dev server both serve /git.
#                            (default: /git).
# VITE_SYNC_POLL_INTERVAL_MS: how often to check for remote changes (default 15000).

# VITE_SYNC_ENABLED=true
# VITE_SYNC_AUTO_SAVE=false
# VITE_BITBUCKET_API_BASE=https://api.bitbucket.org/2.0
# VITE_BITBUCKET_WORKSPACE=
# VITE_BITBUCKET_REPO=
# VITE_BITBUCKET_GIT_URL=
# VITE_BITBUCKET_BRANCH=main
# VITE_BITBUCKET_FILE_PATH=diagrams/{diagramId}.json
# VITE_BITBUCKET_USERNAME=
# VITE_BITBUCKET_API_TOKEN=
# VITE_BITBUCKET_APP_PASSWORD=
# VITE_SYNC_GIT_CORS_PROXY=/git
# VITE_SYNC_POLL_INTERVAL_MS=15000